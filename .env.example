NODE_ENV=development
APP_URL=http://localhost:3000
PORT=8787

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gostudy
DATABASE_SSL_MODE=disable
PG_POOL_MAX=10

DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Generate a unique secret, for example: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800

# Set this to the number of trusted reverse proxies in production, if applicable.
TRUST_PROXY=false
