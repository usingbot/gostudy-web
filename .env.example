NODE_ENV=development
APP_URL=http://localhost:3000
PORT=8787

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gostudy
DATABASE_SSL_MODE=disable
PG_POOL_MAX=10

DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Dedicated GIPHY Web platform key. Vite exposes VITE_* values to the browser;
# this key is browser-visible by design and must not reuse any server secret.
VITE_GIPHY_API_KEY=replace-with-dedicated-web-giphy-api-key

# Private Cloudflare R2 bucket credentials used only by the Express server.
# Scope this token to this bucket with Object Read & Write permission.
R2_ACCOUNT_ID=replace-with-lowercase-32-character-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=replace-with-private-photo-frame-bucket

# Generate a unique secret, for example: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800

# Set this to the number of trusted reverse proxies in production, if applicable.
TRUST_PROXY=false
